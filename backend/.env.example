# ============================================
# LLM SQL Evaluation System - Environment Configuration
# ============================================
# Copie este arquivo para .env e configure com seus valores
# Feature 1: Database Docker Setup & Schema
# ============================================

# ===================================
# DATABASE CONFIGURATION
# ===================================
# Connection settings
DB_HOST=localhost                    # Use 'postgres' for Docker, 'localhost' for local
DB_PORT=5432
DB_NAME=llm_sql_eval
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# ===================================
# POSTGRESQL PERFORMANCE TUNING
# ===================================
# Memory settings (adjust based on available RAM)
DB_SHARED_BUFFERS=256MB             # 25% of available RAM (minimum)
DB_WORK_MEM=16MB                    # For sort/hash operations
DB_MAINTENANCE_WORK_MEM=128MB       # For VACUUM, CREATE INDEX
DB_EFFECTIVE_CACHE_SIZE=512MB       # 50% of available RAM

# Checkpoint settings (optimized for bulk writes)
DB_CHECKPOINT_COMPLETION_TARGET=0.9
DB_WAL_BUFFERS=16MB
DB_MIN_WAL_SIZE=1GB
DB_MAX_WAL_SIZE=4GB

# Query planner settings (for SSDs)
DB_RANDOM_PAGE_COST=1.1
DB_EFFECTIVE_IO_CONCURRENCY=200
DB_DEFAULT_STATISTICS_TARGET=100

# Connection settings
DB_MAX_CONNECTIONS=100

# ===================================
# DATA POPULATION CONFIGURATION
# ===================================
# Number of records to generate for each table
SEED_CATEGORIES=50
SEED_SUPPLIERS=100
SEED_PRODUCTS=1000
SEED_CUSTOMERS=2000
SEED_ORDERS=5000
SEED_REVIEWS_PER_PRODUCT_MAX=8

# ===================================
# NODE.JS / BACKEND CONFIGURATION
# ===================================
NODE_ENV=development
PORT=3000

# LLM Configuration
OPENROUTER_API_KEY=sk-or-v1-... # https://openrouter.ai/
OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# CORS
CORS_ORIGIN=http://localhost:8080
