{
  "name": "seed-loader",
  "version": "1.0.0",
  "description": "Database seed data validator and loader using PostgreSQL COPY",
  "main": "load.ts",
  "scripts": {
    "validate": "ts-node validate.ts",
    "load": "ts-node load.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "*.ts",
      "!*.test.ts"
    ]
  },
  "keywords": [
    "seed",
    "database",
    "postgresql",
    "csv",
    "checksum"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "@types/pg-copy-streams": "^1.2.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.2.3",
    "pg": "^8.11.0",
    "pg-copy-streams": "^7.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5"
  }
}
